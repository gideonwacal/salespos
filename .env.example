# Copy to .env and fill in.

# Django backend (see backend/README.md). This is the default, so you can omit it.
VITE_API_URL=http://localhost:8000/api

# --- Legacy Supabase config -------------------------------------------------
# Unused by the app: nothing in src/ calls Supabase. Kept only until the
# supabase/ directory is deleted. Fill in from Project Settings -> API.
# Server-side (SSR / server functions)
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=

# Client-side (inlined into the browser bundle at build time)
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
