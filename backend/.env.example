# Copy to backend/.env and fill in.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres. Create the database first:  createdb pamojahub
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pamojahub

# Where the Vite dev server runs, for CORS. `npm run dev` uses 8080.
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000,http://localhost:5173

# Access/refresh token lifetimes, in minutes and days.
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=14
