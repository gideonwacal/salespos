# Copy to backend/.env and fill in.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres. Create the database first:  createdb pamojahub
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pamojahub

# Where the browser apps run, for CORS. The shop app uses 8080; the console 8090.
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:8090,http://localhost:3000,http://localhost:5173

# Access/refresh token lifetimes, in minutes and days.
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=14

# Where shops send their subscription, and the name they should see when they
# send, so they can tell it reached the right person.
#
# All optional, but until at least one is filled in the billing page has no
# number to show and nobody can pay. A number that is not a real line on that
# network is dropped rather than shown, so check the prefix.

# MTN Uganda: 076, 077, 078, 079 or 039.
SUBSCRIPTION_MOMO_NUMBER=
SUBSCRIPTION_MOMO_NAME=

# Airtel Uganda: 070, 074, 075 or 020.
SUBSCRIPTION_AIRTEL_NUMBER=
SUBSCRIPTION_AIRTEL_NAME=

# Bank transfer. This is also how a card pays: there is no card gateway behind
# SalesPos, so the shop moves the money itself and quotes the reference back.
SUBSCRIPTION_BANK_NAME=
SUBSCRIPTION_BANK_ACCOUNT_NAME=
SUBSCRIPTION_BANK_ACCOUNT_NUMBER=
SUBSCRIPTION_BANK_BRANCH=

# Online payments through Flutterwave — cards and Ugandan mobile money on one
# hosted page. Both values are needed: the secret key makes the option appear,
# the secret hash is what lets a payment activate a plan. Without the hash,
# money is taken and nothing turns on.
#   Keys: Dashboard -> Settings -> API keys (FLWSECK_TEST-... to start with)
#   Hash: Dashboard -> Settings -> Webhooks -> "Secret hash" (you choose it)
#   Webhook URL: http://localhost:8000/api/billing/flutterwave-webhook/
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=
# Which methods the hosted page offers. Leave blank for the default.
FLUTTERWAVE_PAYMENT_OPTIONS=

# Where Flutterwave returns the shop to. Defaults to the first CORS origin.
APP_BASE_URL=http://localhost:8080
